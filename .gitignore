# Python environment and caches: rebuilt from requirements.txt, never shared.
.venv/
__pycache__/
.pytest_cache/

# SQLite files are either rebuilt from schema + seed, or are per-call copies
# and black-box snapshots from test runs. Rebuildable or bulky, so not committed.
*.db
*.db-wal
*.db-shm
runs/

# Local settings stay off git (anything secret, or a real number if one is ever needed).
.env
*.local.*

# Sound files are made again from text by a script (Part 3, C18), and real
# voices from friends must never reach git (C16, plan risk 9).
lab/sounds/
*.wav
*.flac

# Node writes these if anyone ever installs packages for the web phone.
node_modules/

# Part 5 L14: the exam tasks stay out of git until the final run, so nothing is
# tuned on them by accident (Part 6). OneDrive keeps a backup.
packs/food/tasks/exam/
